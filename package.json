{
  "name": "money-tour-android",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @money-tour/web dev",
    "build": "pnpm -r build && node scripts/check-assets.mjs && node scripts/check-models.mjs",
    "assets:generate": "node scripts/social-card.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "simulate": "tsx packages/engine/scripts/simulate.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:directory && pnpm build",
    "qa:board:install": "playwright install chromium firefox webkit",
    "qa:board": "node scripts/qa-board.mjs",
    "qa:menus": "node scripts/qa-menus.mjs",
    "qa:language": "node scripts/qa-language.mjs",
    "qa:turn": "node scripts/qa-turn-form.mjs",
    "qa:social": "node scripts/qa-social-cards.mjs",
    "qa:actions": "node scripts/qa-action-cards.mjs",
    "qa:profiles": "node scripts/qa-player-profiles.mjs",
    "qa:scene": "node scripts/qa-scene-interactions.mjs",
    "qa:lobby": "node scripts/qa-lobby-delay.mjs",
    "android:sync": "pnpm build && node scripts/sync-android.mjs",
    "android:build": "pnpm android:sync && node scripts/build-android.mjs",
    "android:open": "cap open android",
    "android:icons": "node scripts/android-icons.mjs",
    "qa:android:functional": "node scripts/qa-android-functional.mjs",
    "qa:android:device": "node scripts/qa-android-device.mjs",
    "qa:android:visual": "node scripts/qa-android-visual.mjs",
    "test:directory": "pnpm --filter @money-tour/directory test",
    "qa:public": "node --import tsx scripts/qa-public-games.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "playwright": "1.65.0-alpha-2026-10-16",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/share": "^8.0.3"
  }
}
